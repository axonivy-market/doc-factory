<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.axonivy.utils.docfactory</groupId>
  <artifactId>doc-factory-pages</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <docfactory10.version>10.0.24</docfactory10.version>
    <docfactory12.version>12.0.8</docfactory12.version>
    <docfactory13.version>13.2.2</docfactory13.version>
    <docfactory.dev.version>14.0.0-SNAPSHOT</docfactory.dev.version>
    <latest.release>13.2</latest.release>
    <dev.link></dev.link>
    <pages.directory>${project.build.directory}/doc-factory</pages.directory>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>axonivy-releases</id>
      <url>https://maven.axonivy.com</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>write-site-navigation</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${pages.directory}</outputDirectory>
              <delimiters><delimiter>@</delimiter></delimiters>
              <useDefaultDelimiters>false</useDefaultDelimiters>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/common</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>unpack-release-documentation</id>
            <phase>generate-resources</phase>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.axonivy.utils.docfactory</groupId>
                  <artifactId>doc-factory-doc</artifactId>
                  <version>${docfactory10.version}</version>
                  <type>zip</type>
                  <outputDirectory>${pages.directory}/release/10.0</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.axonivy.utils.docfactory</groupId>
                  <artifactId>doc-factory-doc</artifactId>
                  <version>${docfactory12.version}</version>
                  <type>zip</type>
                  <outputDirectory>${pages.directory}/release/12.0</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.axonivy.utils.docfactory</groupId>
                  <artifactId>doc-factory-doc</artifactId>
                  <version>${docfactory13.version}</version>
                  <type>zip</type>
                  <outputDirectory>${pages.directory}/release/13.2</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>preview</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>serve-site-locally</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-m</argument>
                    <argument>jdk.httpserver</argument>
                    <argument>-b</argument>
                    <argument>127.0.0.1</argument>
                    <argument>-d</argument>
                    <argument>${project.build.directory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>dev</id>
      <activation>
        <property><name>includeDev</name><value>true</value></property>
      </activation>
      <repositories>
        <repository>
          <id>axonivy-snapshots</id>
          <url>https://maven.axonivy.com</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <properties>
        <dev.link>&lt;li&gt;&lt;a href="snapshot/dev/index.html"&gt;Development (${docfactory.dev.version})&lt;/a&gt;&lt;/li&gt;</dev.link>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>require-dev-snapshot</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>docfactory.dev.version</property>
                      <regex>.+-SNAPSHOT</regex>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-dev-documentation</id>
                <phase>generate-resources</phase>
                <goals><goal>unpack</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>com.axonivy.utils.docfactory</groupId>
                      <artifactId>doc-factory-doc</artifactId>
                      <version>${docfactory.dev.version}</version>
                      <type>zip</type>
                      <outputDirectory>${pages.directory}/snapshot/dev</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
